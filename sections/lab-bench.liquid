{% comment %}
  KONBINI workbench — ticket 04.

  The place every later component is reviewed. Not a storefront section: it is
  never added to a customer-facing page, and its labels are deliberately in
  English rather than translated, because only we ever see it.

  Three modes, one file:

    design mode   the subject renders directly, so the theme editor can select
                  and edit the blocks inside it. No iframe — the editor cannot
                  reach into one.
    bench         the storefront view. A switcher bar plus a frame carrying
                  this same page. The frame is what makes 375 ↔ 1296 ↔ 1720 real on a
                  phone: it has its own viewport, so Horizon's media queries
                  fire on the frame width, not the device width.

                  It is fed by fetch and document.write rather than pointed at
                  a URL, because Shopify serves the storefront with
                  x-frame-options: DENY and frame-ancestors 'none' — framing
                  the page by src is refused even same-origin. See load().
    bare          the subject alone, entered either by ?bare=1 in the address
                  bar or by the boot class the bench writes in. On page.lab the
                  theme chrome is hidden too; on page.lab-context it stays,
                  which is the whole difference between the two templates.

  The long-content switcher swaps any element carrying data-lab-text. Our own
  blocks should carry it on the fields that break first — the title above all.
  Horizon's blocks do not, so for those the specimen line below is the test.
{% endcomment %}

{%- liquid
  assign hides_chrome = false
  if template.suffix == 'lab'
    assign hides_chrome = true
  endif
-%}

<div class="lab" data-lab-hides-chrome="{{ hides_chrome }}">
  {%- unless request.design_mode -%}
    <div class="lab__bar" role="group" aria-label="Workbench controls">
      <span class="lab__legend">Ekran</span>
      <button type="button" class="lab__btn" data-lab-set="screen" data-lab-value="mobile" aria-pressed="true">Mobile</button>
      <button type="button" class="lab__btn" data-lab-set="screen" data-lab-value="desktop" aria-pressed="false">Desktop</button>

      <span class="lab__sep" aria-hidden="true"></span>

      <span class="lab__group" data-lab-for="mobile">
        <span class="lab__legend">Telefon</span>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="375x667" data-lab-name="SE 3" aria-pressed="true">375·667</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="375x812" data-lab-name="13 mini" aria-pressed="false">375·812</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="390x844" data-lab-name="12 · 13 · 14" aria-pressed="false">390·844</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="393x852" data-lab-name="14 Pro · 15 · 16" aria-pressed="false">393·852</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="402x874" data-lab-name="16 Pro" aria-pressed="false">402·874</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="430x932" data-lab-name="15 Pro Max · 16 Plus" aria-pressed="false">430·932</button>
        <button type="button" class="lab__btn" data-lab-set="phone" data-lab-value="440x956" data-lab-name="16 Pro Max" aria-pressed="false">440·956</button>
      </span>

      <span class="lab__group" data-lab-for="desktop" hidden>
        <span class="lab__legend">Szerokość</span>
        <button type="button" class="lab__btn" data-lab-set="desktop" data-lab-value="1296" aria-pressed="true">1296</button>
        <button type="button" class="lab__btn" data-lab-set="desktop" data-lab-value="1720" aria-pressed="false">1720</button>
      </span>

      <span class="lab__sep" aria-hidden="true"></span>

      <span class="lab__legend">Widok</span>
      <button type="button" class="lab__btn" data-lab-set="view" data-lab-value="one" aria-pressed="false">1 karta</button>
      <button type="button" class="lab__btn" data-lab-set="view" data-lab-value="row" aria-pressed="false">Rząd</button>
      <button type="button" class="lab__btn" data-lab-set="view" data-lab-value="grid" aria-pressed="true">Kilka rzędów</button>

      <span class="lab__sep" aria-hidden="true"></span>

      <span class="lab__legend">Język</span>
      <button type="button" class="lab__btn" data-lab-set="lang" data-lab-value="pl" aria-pressed="true">pl</button>
      <button type="button" class="lab__btn" data-lab-set="lang" data-lab-value="en" aria-pressed="false">en</button>
      <button type="button" class="lab__btn" data-lab-set="lang" data-lab-value="ja" aria-pressed="false">ja</button>
      <button type="button" class="lab__btn" data-lab-set="lang" data-lab-value="ko" aria-pressed="false">ko</button>

      <span class="lab__sep" aria-hidden="true"></span>

      <span class="lab__legend">Wyrównanie</span>
      <button type="button" class="lab__btn" data-lab-set="fit" data-lab-value="on" aria-pressed="true">Auto</button>
      <button type="button" class="lab__btn" data-lab-set="fit" data-lab-value="off" aria-pressed="false">Wył.</button>

      <span class="lab__scale" data-lab-scale></span>
    </div>

    <div class="lab__stage" data-lab-stage>
      <div class="lab__device" data-lab-device>
        <iframe
          class="lab__frame"
          title="Component under review"
          data-lab-frame
          src="about:blank"
          loading="eager"
        ></iframe>
      </div>
    </div>
  {%- endunless -%}

  <div
    class="lab__subject lab__subject--{{ section.settings.layout }} spacing-style"
    data-lab-subject
    style="background: {{ section.settings.stage_background | default: '#ffffff' }}; {% render 'spacing-padding', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- if section.settings.show_specimen -%}
      <p class="lab__specimen" data-lab-text>{{ section.settings.title_real }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Grid layout: the collection grid's geometry, so a card is reviewed at the
     size it ships at. 375px gives two 165px cards: 16px margins, 13px gap
     (ticket 11). From 750px up, 400px cards 24px apart. */
  .lab__subject--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 13px;
    padding-inline: 16px;
  }

  .lab__subject--grid > product-card {
    display: grid;
    height: 100%;
    min-width: 0;
  }

  .lab__subject--grid > .lab__specimen {
    grid-column: 1 / -1;
  }

  @media screen and (min-width: 750px) {
    .lab__subject--grid {
      grid-template-columns: repeat(auto-fill, 400px);
      justify-content: center;
      gap: 24px;
      padding-inline: 24px;
    }
  }

  .lab__bar {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #111;
    color: #fff;
    font-size: 12px;
    line-height: 1;
  }

  .lab__legend {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6f6f6f;
    margin-right: 2px;
  }

  .lab__btn {
    appearance: none;
    border: 1px solid #444;
    background: transparent;
    color: #bbb;
    font: inherit;
    padding: 6px 10px;
    cursor: pointer;
  }

  .lab__btn[aria-pressed='true'] {
    background: #fff;
    border-color: #fff;
    color: #111;
  }

  .lab__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lab__sep {
    width: 1px;
    height: 18px;
    background: #3a3a3a;
    margin: 0 4px;
  }

  .lab__scale {
    margin-left: auto;
    font-size: 11px;
    color: #8a8a8a;
  }

  .lab__bar {
    row-gap: 6px;
  }

  .lab__group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .lab__group[hidden] {
    display: none;
  }

  /* tint-50 stage, so a white phone and a white page both read against it. */
  .lab__stage {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 24px 16px;
    overflow: hidden;
    background: #f4f4f4;
  }

  .lab__device {
    flex: 0 0 auto;
    transform-origin: top center;
    background: #fff;
  }

  /* A hairline phone: one rule, a 46px corner and a bezel, nothing else. It
     stops the mobile card being judged as a rectangle floating on white. */
  .lab__device--phone {
    padding: 10px;
    border: 1px solid #d9d9d9;
    border-radius: 46px;
  }

  .lab__device--phone .lab__frame {
    border-radius: 36px;
  }

  .lab__frame {
    display: block;
    border: 0;
    background: #fff;
  }

  /* ---------- views, inside the framed page ---------- */
  /* One card: a one-column card is not the two-column card left alone. It
     takes the screen less 24px margins (ticket 11). */
  html[data-lab-view='one'] .lab__subject--grid {
    grid-template-columns: minmax(0, 1fr);
    padding-inline: 24px;
  }

  html[data-lab-view='one'][data-lab-screen='desktop'] .lab__subject--grid {
    grid-template-columns: 400px;
    justify-content: center;
  }

  html[data-lab-view='one'] .lab__subject--grid > product-card:not(:first-of-type) {
    display: none;
  }

  /* One row: whatever the column count, only the first row has height. */
  html[data-lab-view='row'] .lab__subject--grid {
    grid-template-rows: auto;
    grid-auto-rows: 0;
    row-gap: 0;
    overflow: hidden;
  }

  /* The subject is rendered in every mode so the theme editor can reach it,
     but on the storefront bench it is the iframe that gets looked at. */
  .lab--bench .lab__subject {
    display: none;
  }

  .lab--bare .lab__bar,
  .lab--bare .lab__stage {
    display: none;
  }

  .lab__specimen {
    margin: 0;
    font-size: 15px;
    text-wrap: pretty;
  }

  /* page.lab: one block, alone, on white, nothing else. Applies to the bench
     page and to the framed document. */
  html.lab-no-chrome #header-group,
  html.lab-no-chrome footer,
  html.lab-no-chrome .shopify-section-group-header-group,
  html.lab-no-chrome .shopify-section-group-footer-group {
    display: none !important;
  }

  /* The framed document is a copy of this page, so Shopify's draft-theme bar
     is written into it as well and covers the component. The bench page keeps
     its own bar; the frame does not need a second one. The frame also has to
     grow to its content, so nothing in it may clip. */
  html.lab-bare-boot #PBarNextFrameWrapper {
    display: none !important;
  }

  html.lab-bare-boot,
  html.lab-bare-boot body {
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('.lab');
    if (!root) return;

    var params = new URLSearchParams(window.location.search);
    var docEl = document.documentElement;

    /* Two ways in to bare mode. The query string is for opening the bare view
       directly in a tab. The boot class is how the bench does it: the frame is
       written into rather than navigated to, so it has no query string of its
       own — see load() for why it cannot simply be pointed at the URL. */
    var isBare = docEl.classList.contains('lab-bare-boot') || params.get('bare') === '1';
    var subject = root.querySelector('[data-lab-subject]');

    var strings = {
      off: {{ section.settings.title_real | json }},
      pl: {{ section.settings.title_long | json }},
      ja: {{ section.settings.title_ja | json }},
      ko: {{ section.settings.title_ko | json }}
    };
    var locales = { off: null, pl: 'pl', ja: 'ja', ko: 'ko' };

    /* Placeholder translations per product handle, written by the build
       script. What is real is how each script wraps, not the wording. */
    var translations = {};
    try {
      /* No Liquid default here: a literal '{}' ends the output tag early. */
      translations = JSON.parse({{ section.settings.translations | json }} || '{}');
    } catch (e) {
      translations = {};
    }

    /* ---------- bare: the subject alone ---------- */
    if (isBare) {
      root.classList.add('lab--bare');
      if (root.dataset.labHidesChrome === 'true') {
        document.documentElement.classList.add('lab-no-chrome');
      }

      var pick = docEl.getAttribute('data-lab-long') || params.get('long') || 'off';
      if (strings[pick]) {
        var lang = locales[pick];
        subject.querySelectorAll('[data-lab-text]').forEach(function (node) {
          node.textContent = strings[pick];
          if (lang) {
            node.setAttribute('lang', lang);
          } else {
            node.removeAttribute('lang');
          }
        });
      }
      return;
    }

    /* ---------- bench: switchers driving an iframe ---------- */
    var bar = root.querySelector('.lab__bar');
    if (!bar) return; // design mode renders the subject directly

    root.classList.add('lab--bench');
    /* page.lab shows the component and nothing else, on the bench as well as
       in bare mode. Without this the store header and footer wrap the bench. */
    if (root.dataset.labHidesChrome === 'true') {
      docEl.classList.add('lab-no-chrome');
    }

    var stage = root.querySelector('[data-lab-stage]');
    var device = root.querySelector('[data-lab-device]');
    var frame = root.querySelector('[data-lab-frame]');
    var readout = root.querySelector('[data-lab-scale]');
    var TITLE = '.product-card__content > a.contents > .text-block p';
    var BEZEL = 10;

    var state = {
      screen: 'mobile',
      phone: '375x667',
      desktop: '1296',
      view: 'grid',
      lang: 'pl',
      fit: 'on'
    };

    function press(group, value) {
      bar.querySelectorAll('[data-lab-set="' + group + '"]').forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-lab-value') === value));
      });
    }

    function inner() {
      try {
        return frame.contentDocument && frame.contentDocument.body ? frame.contentDocument : null;
      } catch (e) {
        return null;
      }
    }

    /* Everything the framed page needs to know goes in as attributes on its
       <html>, so a switch never reloads the frame. */
    function apply() {
      var doc = inner();
      if (!doc) return;
      var html = doc.documentElement;
      html.setAttribute('data-lab-view', state.view);
      html.setAttribute('data-lab-screen', state.screen);
      html.setAttribute('data-konbini-fit', state.fit);

      /* Language: swap each card title for its placeholder translation and
         mark the language, so the per-language line rules apply. */
      doc.querySelectorAll('product-card').forEach(function (card) {
        var title = card.querySelector(TITLE);
        var link = card.querySelector('a[href*="/products/"]');
        if (!title || !link) return;

        if (title.dataset.konbiniTitle !== undefined) {
          title.textContent = title.dataset.konbiniTitle;
          delete title.dataset.konbiniTitle;
          title.removeAttribute('title');
        }
        if (title.dataset.labOriginal === undefined) {
          title.dataset.labOriginal = title.textContent.trim();
        }

        var handle = link.getAttribute('href').split('/products/')[1].split(/[?#]/)[0];
        var set = translations[handle] || {};
        var text = state.lang === 'pl' ? title.dataset.labOriginal : set[state.lang];
        title.textContent = text || title.dataset.labOriginal;
        title.setAttribute('lang', text ? state.lang : 'pl');
      });

      frame.contentWindow.dispatchEvent(new Event('konbini:cards-changed'));
    }

    function size() {
      var available = stage.clientWidth - 32;
      var width;
      var height = null;

      if (state.screen === 'mobile') {
        var parts = state.phone.split('x');
        width = parseInt(parts[0], 10);
        height = parseInt(parts[1], 10);
      } else {
        width = parseInt(state.desktop, 10);
      }

      var outer = state.screen === 'mobile' ? width + BEZEL * 2 : width;
      var scale = Math.min(1, available / outer);

      frame.style.width = width + 'px';
      device.classList.toggle('lab__device--phone', state.screen === 'mobile');

      if (height === null) {
        /* Desktop: the frame grows to its content. Collapse before measuring,
           and measure the subject rather than the body: Horizon can leave the
           framed document at a fixed height with hidden overflow, and then
           scrollHeight only reports the frame's own height back. */
        var doc = inner();
        height = 1200;
        if (doc) {
          frame.style.height = '0px';
          var inside = doc.querySelector('[data-lab-subject]');
          var bottom = inside
            ? inside.getBoundingClientRect().bottom + (frame.contentWindow.scrollY || 0)
            : doc.body.scrollHeight;
          height = Math.max(Math.ceil(bottom), 320);
        }
      }
      /* Mobile: the frame is the phone's real height, so the page clips at
         the fold and scrolls inside, as it does in the hand. */
      frame.style.height = height + 'px';

      device.style.transform = 'scale(' + scale + ')';
      var box = device.getBoundingClientRect();
      stage.style.height = Math.ceil(box.height + 48) + 'px';

      var label;
      if (state.screen === 'mobile') {
        var chosen = bar.querySelector('[data-lab-set="phone"][aria-pressed="true"]');
        label = 'iPhone ' + (chosen ? chosen.getAttribute('data-lab-name') : '') + ' · ' + width + ' × ' + height + ' px';
      } else {
        label = width + ' px';
      }
      var doc2 = inner();
      var card = doc2 ? doc2.querySelector('product-card') : null;
      if (card) label += ' · karta ' + Math.round(card.getBoundingClientRect().width) + ' px';
      if (scale < 1) label += ' · ' + Math.round(scale * 100) + '%';
      readout.textContent = label;
    }

    function refresh() {
      bar.querySelectorAll('[data-lab-for]').forEach(function (group) {
        group.hidden = group.getAttribute('data-lab-for') !== state.screen;
      });
      Object.keys(state).forEach(function (key) {
        press(key, state[key]);
      });
      apply();
      size();
      // Titles re-wrap after a switch; measure once they have.
      setTimeout(size, 250);
    }

    /* The frame is fed, not navigated.

       Shopify serves the storefront with `x-frame-options: DENY` and
       `frame-ancestors 'none'`, so <iframe src="/pages/lab"> is refused even
       same-origin — confirmed against the live headers, not assumed. What is
       not refused is fetching the same page and writing it into a blank
       same-origin frame: no navigation, no framing headers to enforce.

       The written document has no query string, so bare mode is handed to it
       as a class on <html> before the write. A <base> goes in with it, since
       relative URLs would otherwise resolve against about:blank. */
    function load() {
      var url = window.location.pathname;

      fetch(url, { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.text();
        })
        .then(function (html) {
          html = html
            .replace(/<html/i, '<html class="lab-bare-boot"')
            .replace(/<head([^>]*)>/i, '<head$1><base href="' + window.location.origin + '/">');

          var doc = frame.contentDocument;
          doc.open();
          doc.write(html);
          doc.close();

          refresh();
          // Type, images and the section's own stylesheet settle after first
          // paint; apply and measure again once they have.
          setTimeout(refresh, 600);
          setTimeout(refresh, 1500);
        })
        .catch(function (error) {
          readout.textContent = 'load failed — ' + error.message;
        });
    }

    bar.addEventListener('click', function (event) {
      var btn = event.target.closest('button[data-lab-set]');
      if (!btn) return;
      state[btn.getAttribute('data-lab-set')] = btn.getAttribute('data-lab-value');
      refresh();
    });

    window.addEventListener('resize', size);
    load();
  })();
</script>

{% schema %}
{
  "name": "Workbench",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Stage"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stack" },
        { "value": "grid", "label": "Product grid" }
      ],
      "default": "stack"
    },
    {
      "type": "color",
      "id": "stage_background",
      "label": "Stage background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_specimen",
      "label": "Show the specimen line",
      "info": "A single line carrying data-lab-text, so the content switcher is visible even before a component under review carries the attribute itself.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "translations",
      "label": "Card title translations (JSON)",
      "info": "Written by scripts/build-lab-product-card.py. Keyed by product handle, then en, ja, ko."
    },
    {
      "type": "header",
      "content": "Long content"
    },
    {
      "type": "text",
      "id": "title_real",
      "label": "Real title",
      "default": "Mirin"
    },
    {
      "type": "text",
      "id": "title_long",
      "label": "Longest Polish title",
      "info": "The worst case the card has to survive. Refresh it from the store when a longer one is found.",
      "default": "YAMACHU Gochujang Korean Chili Paste / Pikantna pasta z chili 40 g"
    },
    {
      "type": "text",
      "id": "title_ja",
      "label": "Japanese title",
      "default": "ヤマチュウ コチュジャン 韓国唐辛子味噌 ピリ辛チリペースト 40 g"
    },
    {
      "type": "text",
      "id": "title_ko",
      "label": "Korean title",
      "default": "야마추 고추장 한국 고추 페이스트 매운 칠리 페이스트 40 g"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
