{% comment %}
  KONBINI workbench — ticket 04.

  The place every later component is reviewed. Not a storefront section: it is
  never added to a customer-facing page, and its labels are deliberately in
  English rather than translated, because only we ever see it.

  Three modes, one file:

    design mode   the subject renders directly, so the theme editor can select
                  and edit the blocks inside it. No iframe — the editor cannot
                  reach into one.
    bench         the storefront view. A switcher bar plus a frame carrying
                  this same page. The frame is what makes 375 ↔ 1296 ↔ 1720 real on a
                  phone: it has its own viewport, so Horizon's media queries
                  fire on the frame width, not the device width.

                  It is fed by fetch and document.write rather than pointed at
                  a URL, because Shopify serves the storefront with
                  x-frame-options: DENY and frame-ancestors 'none' — framing
                  the page by src is refused even same-origin. See load().
    bare          the subject alone, entered either by ?bare=1 in the address
                  bar or by the boot class the bench writes in. On page.lab the
                  theme chrome is hidden too; on page.lab-context it stays,
                  which is the whole difference between the two templates.

  The long-content switcher swaps any element carrying data-lab-text. Our own
  blocks should carry it on the fields that break first — the title above all.
  Horizon's blocks do not, so for those the specimen line below is the test.
{% endcomment %}

{%- liquid
  assign hides_chrome = false
  if template.suffix == 'lab'
    assign hides_chrome = true
  endif
-%}

<div class="lab" data-lab-hides-chrome="{{ hides_chrome }}">
  {%- unless request.design_mode -%}
    <div class="lab__bar" role="group" aria-label="Workbench controls">
      <span class="lab__legend">Width</span>
      <button type="button" class="lab__btn" data-lab-width="375" aria-pressed="true">375</button>
      <button type="button" class="lab__btn" data-lab-width="1296" aria-pressed="false">1296</button>
      <button type="button" class="lab__btn" data-lab-width="1720" aria-pressed="false">1720</button>

      <span class="lab__sep" aria-hidden="true"></span>

      <span class="lab__legend">Content</span>
      <button type="button" class="lab__btn" data-lab-long="off" aria-pressed="true">Real</button>
      <button type="button" class="lab__btn" data-lab-long="pl" aria-pressed="false">Long pl</button>
      <button type="button" class="lab__btn" data-lab-long="ja" aria-pressed="false">ja</button>
      <button type="button" class="lab__btn" data-lab-long="ko" aria-pressed="false">ko</button>

      <span class="lab__scale" data-lab-scale></span>
    </div>

    <div class="lab__stage" data-lab-stage>
      <iframe
        class="lab__frame"
        title="Component under review"
        data-lab-frame
        src="about:blank"
        loading="eager"
      ></iframe>
    </div>
  {%- endunless -%}

  <div
    class="lab__subject lab__subject--{{ section.settings.layout }} spacing-style"
    data-lab-subject
    style="background: {{ section.settings.stage_background | default: '#ffffff' }}; {% render 'spacing-padding', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- if section.settings.show_specimen -%}
      <p class="lab__specimen" data-lab-text>{{ section.settings.title_real }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Grid layout: the collection grid's geometry, so a card is reviewed at the
     size it ships at. 375px gives two 165px cards: 16px margins, 13px gap
     (ticket 11). From 750px up, 400px cards 24px apart. */
  .lab__subject--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 13px;
    padding-inline: 16px;
  }

  .lab__subject--grid > product-card {
    display: grid;
    height: 100%;
    min-width: 0;
  }

  .lab__subject--grid > .lab__specimen {
    grid-column: 1 / -1;
  }

  @media screen and (min-width: 750px) {
    .lab__subject--grid {
      grid-template-columns: repeat(auto-fill, 400px);
      gap: 24px;
      padding-inline: 24px;
    }
  }

  .lab__bar {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #111;
    color: #fff;
    font-size: 12px;
    line-height: 1;
  }

  .lab__legend {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6f6f6f;
    margin-right: 2px;
  }

  .lab__btn {
    appearance: none;
    border: 1px solid #444;
    background: transparent;
    color: #bbb;
    font: inherit;
    padding: 6px 10px;
    cursor: pointer;
  }

  .lab__btn[aria-pressed='true'] {
    background: #fff;
    border-color: #fff;
    color: #111;
  }

  .lab__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lab__sep {
    width: 1px;
    height: 18px;
    background: #3a3a3a;
    margin: 0 4px;
  }

  .lab__scale {
    margin-left: auto;
    font-size: 11px;
    color: #8a8a8a;
  }

  .lab__stage {
    overflow: hidden;
    background: #e7e7e5;
  }

  .lab__frame {
    display: block;
    border: 0;
    transform-origin: top left;
    background: #fff;
  }

  /* The subject is rendered in every mode so the theme editor can reach it,
     but on the storefront bench it is the iframe that gets looked at. */
  .lab--bench .lab__subject {
    display: none;
  }

  .lab--bare .lab__bar,
  .lab--bare .lab__stage {
    display: none;
  }

  .lab__specimen {
    margin: 0;
    font-size: 15px;
    text-wrap: pretty;
  }

  /* page.lab: one block, alone, on white, nothing else. Applies to the bench
     page and to the framed document. */
  html.lab-no-chrome #header-group,
  html.lab-no-chrome footer,
  html.lab-no-chrome .shopify-section-group-header-group,
  html.lab-no-chrome .shopify-section-group-footer-group {
    display: none !important;
  }

  /* The framed document is a copy of this page, so Shopify's draft-theme bar
     is written into it as well and covers the component. The bench page keeps
     its own bar; the frame does not need a second one. The frame also has to
     grow to its content, so nothing in it may clip. */
  html.lab-bare-boot #PBarNextFrameWrapper {
    display: none !important;
  }

  html.lab-bare-boot,
  html.lab-bare-boot body {
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('.lab');
    if (!root) return;

    var params = new URLSearchParams(window.location.search);
    var docEl = document.documentElement;

    /* Two ways in to bare mode. The query string is for opening the bare view
       directly in a tab. The boot class is how the bench does it: the frame is
       written into rather than navigated to, so it has no query string of its
       own — see load() for why it cannot simply be pointed at the URL. */
    var isBare = docEl.classList.contains('lab-bare-boot') || params.get('bare') === '1';
    var subject = root.querySelector('[data-lab-subject]');

    var strings = {
      off: {{ section.settings.title_real | json }},
      pl: {{ section.settings.title_long | json }},
      ja: {{ section.settings.title_ja | json }},
      ko: {{ section.settings.title_ko | json }}
    };
    var locales = { off: null, pl: 'pl', ja: 'ja', ko: 'ko' };

    /* ---------- bare: the subject alone ---------- */
    if (isBare) {
      root.classList.add('lab--bare');
      if (root.dataset.labHidesChrome === 'true') {
        document.documentElement.classList.add('lab-no-chrome');
      }

      var pick = docEl.getAttribute('data-lab-long') || params.get('long') || 'off';
      if (strings[pick]) {
        var lang = locales[pick];
        subject.querySelectorAll('[data-lab-text]').forEach(function (node) {
          node.textContent = strings[pick];
          if (lang) {
            node.setAttribute('lang', lang);
          } else {
            node.removeAttribute('lang');
          }
        });
      }
      return;
    }

    /* ---------- bench: switchers driving an iframe ---------- */
    var bar = root.querySelector('.lab__bar');
    if (!bar) return; // design mode renders the subject directly

    root.classList.add('lab--bench');
    /* page.lab shows the component and nothing else, on the bench as well as
       in bare mode. Without this the store header and footer wrap the bench. */
    if (root.dataset.labHidesChrome === 'true') {
      docEl.classList.add('lab-no-chrome');
    }

    var stage = root.querySelector('[data-lab-stage]');
    var frame = root.querySelector('[data-lab-frame]');
    var readout = root.querySelector('[data-lab-scale]');
    var state = { width: 375, long: 'off' };

    function press(attr, value) {
      bar.querySelectorAll('[' + attr + ']').forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(btn.getAttribute(attr) === value));
      });
    }

    function fit() {
      var available = stage.clientWidth;
      var scale = Math.min(1, available / state.width);
      frame.style.width = state.width + 'px';
      frame.style.transform = 'scale(' + scale + ')';
      // Centre the frame in the stage instead of pinning it to the left edge.
      frame.style.marginLeft = Math.max(0, (available - state.width * scale) / 2) + 'px';

      var inner = 1200;
      try {
        var doc = frame.contentDocument;
        if (doc && doc.body) {
          /* Collapse before measuring. The frame's own height is what
             scrollHeight reports back once it is set, so measuring without
             this makes the stage grow and never shrink. */
          frame.style.height = '0px';
          /* Measure the subject, not the body. Horizon can leave the framed
             document with a fixed height and hidden overflow, and then
             scrollHeight reports the frame's own height back: at 1280 the
             bench showed 320px of a 2500px page. */
          var inside = doc.querySelector('[data-lab-subject]');
          var bottom = inside
            ? inside.getBoundingClientRect().bottom + (frame.contentWindow.scrollY || 0)
            : doc.body.scrollHeight;
          inner = Math.max(Math.ceil(bottom), 320);
        }
      } catch (e) {
        /* same-origin only; the fallback height is fine */
      }
      frame.style.height = inner + 'px';
      stage.style.height = Math.ceil(inner * scale) + 'px';

      readout.textContent = state.width + ' px · ' + Math.round(scale * 100) + '%';
    }

    /* The frame is fed, not navigated.

       Shopify serves the storefront with `x-frame-options: DENY` and
       `frame-ancestors 'none'`, so <iframe src="/pages/lab"> is refused even
       same-origin — confirmed against the live headers, not assumed. What is
       not refused is fetching the same page and writing it into a blank
       same-origin frame: no navigation, no framing headers to enforce.

       The written document has no query string, so bare mode is handed to it
       as a class on <html> before the write. A <base> goes in with it, since
       relative URLs would otherwise resolve against about:blank. */
    function load() {
      var url = window.location.pathname;

      fetch(url, { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.text();
        })
        .then(function (html) {
          html = html
            .replace(/<html/i, '<html class="lab-bare-boot" data-lab-long="' + state.long + '"')
            .replace(/<head([^>]*)>/i, '<head$1><base href="' + window.location.origin + '/">');

          var doc = frame.contentDocument;
          doc.open();
          doc.write(html);
          doc.close();

          fit();
          // Type, images and the section's own stylesheet settle after first
          // paint; measure again once they have.
          setTimeout(fit, 400);
          setTimeout(fit, 1200);
        })
        .catch(function (error) {
          readout.textContent = 'load failed — ' + error.message;
        });
    }

    bar.addEventListener('click', function (event) {
      var btn = event.target.closest('button');
      if (!btn) return;

      if (btn.hasAttribute('data-lab-width')) {
        state.width = parseInt(btn.getAttribute('data-lab-width'), 10);
        press('data-lab-width', String(state.width));
        fit();
        return;
      }

      if (btn.hasAttribute('data-lab-long')) {
        state.long = btn.getAttribute('data-lab-long');
        press('data-lab-long', state.long);
        load();
      }
    });

    window.addEventListener('resize', fit);
    load();
  })();
</script>

{% schema %}
{
  "name": "Workbench",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Stage"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stack" },
        { "value": "grid", "label": "Product grid" }
      ],
      "default": "stack"
    },
    {
      "type": "color",
      "id": "stage_background",
      "label": "Stage background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_specimen",
      "label": "Show the specimen line",
      "info": "A single line carrying data-lab-text, so the content switcher is visible even before a component under review carries the attribute itself.",
      "default": true
    },
    {
      "type": "header",
      "content": "Long content"
    },
    {
      "type": "text",
      "id": "title_real",
      "label": "Real title",
      "default": "Mirin"
    },
    {
      "type": "text",
      "id": "title_long",
      "label": "Longest Polish title",
      "info": "The worst case the card has to survive. Refresh it from the store when a longer one is found.",
      "default": "YAMACHU Gochujang Korean Chili Paste / Pikantna pasta z chili 40 g"
    },
    {
      "type": "text",
      "id": "title_ja",
      "label": "Japanese title",
      "default": "ヤマチュウ コチュジャン 韓国唐辛子味噌 ピリ辛チリペースト 40 g"
    },
    {
      "type": "text",
      "id": "title_ko",
      "label": "Korean title",
      "default": "야마추 고추장 한국 고추 페이스트 매운 칠리 페이스트 40 g"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
